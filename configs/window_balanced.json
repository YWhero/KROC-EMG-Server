  "n_encoder_layers": 4,
  "n_decoder_layers": 1,
  "n_vae_encoder_layers": 4,
  "backbone_weights": "ResNet18_Weights.IMAGENET1K_V1",
  "sample_rate_hz": 2000,
  "window_ms": 200,
  "rms_ms": 50,
  "max_gap_ms": 2.0,
  "max_emg_age_ms": 100.0,
  "video_backend": "pyav",
  "save_freq": 20000,
  "keep_checkpoints": 3,
  "eval_freq": 1000,
  "val_batches": null,
  "log_freq": 100,
  "annotations": "../data/study_annotations.json",
  "checkpoint_archive": {
    "mode": "relay",
    "repo_id": "HYHero/kroc-act-emg-balanced-20261123",
    "private": true,
    "wait_timeout_seconds": 86400,
    "poll_seconds": 5,
    "final_best_only": true
