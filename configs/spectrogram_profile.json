{
  "variant": "spectrogram",
  "repo_id": "dorii22/red_pen_adaptive_handover_lerobot",
  "dataset_root": "../data/lerobot_v3",
  "manifest": "../data/emg/manifest.json",
  "splits": "../data/balanced_splits.json",
  "output_dir": "../outputs/spectrogram_profile",
  "device": "cuda",
  "seed": 1000,
  "steps": 120,
  "batch_size": 8,
  "chunk_size": 30,
  "n_action_steps": 15,
  "lr": 1e-05,
  "weight_decay": 0.0001,
  "grad_clip": 10.0,
  "dim_model": 512,
  "dim_feedforward": 3200,
  "n_heads": 8,
  "n_encoder_layers": 4,
  "n_decoder_layers": 1,
  "n_vae_encoder_layers": 4,
  "backbone_weights": "ResNet18_Weights.IMAGENET1K_V1",
  "sample_rate_hz": 2000,
  "window_ms": 200,
  "rms_ms": 50,
  "max_gap_ms": 2.0,
  "max_emg_age_ms": 100.0,
  "video_backend": "pyav",
  "save_freq": 20000,
  "keep_checkpoints": 3,
  "eval_freq": 120,
  "val_batches": 4,
  "log_freq": 20,
  "annotations": "../data/study_annotations.json",
  "checkpoint_archive": {},
  "frame_cache": "../data/frame_cache_200ms",
  "loader_workers": 2,
  "spectrogram": {
    "frame_ms": 64,
    "hop_ms": 16,
    "n_fft": 256,
    "frequency_hz": [
      20,
      450
    ]
  }
}
